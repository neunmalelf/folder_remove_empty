#!/usr/bin/env bash
# Pre-commit hook: modular check suite for folder_remove_empty.
# Validates version stamps and skill synchronization, then runs whole-project
# linting (ruff), type checking (mypy), the test suite, a window smoke (the
# window opens and paints no accent fill), a generated-page drift check
# (man/tldr pages vs. the program) and an optional build.
#
# Usage:
#   Direct execution: hooks/pre-commit [OPTIONS]
#   Options:
#     -h, --help           Show this help message and exit
#     --list-modules       List all available check modules
#     --run=<module>       Run only the specified module
#     --version            Show hook version and exit
#
# Environment variables:
#   SKIP_HOOKS=1              Bypass all pre-commit hook modules
#   SKIP_VERSION=1            Skip version validation (_check_version)
#   SKIP_SKILL_SYNC=1         Skip AGENTS.md skill index validation (_skill_sync)
#   SKIP_RUFF=1               Skip whole-project ruff linting
#   SKIP_MYPY=1               Skip mypy type checking
#   SKIP_TESTS=1              Skip test suite execution
#   SKIP_GUI=1                Skip the window smoke (needs a display or xvfb-run)
#   SKIP_DOCS=1               Skip generated man/tldr page drift validation
#   SKIP_PINS=1               Skip the dev-tool pin drift reminder (_check_pins)
#   SKIP_BUILD=1              Skip build validation
#   PRE_COMMIT_BUILD=1        Enable standalone build verification (_build)

__VERSION__="3.3.20260927213500Z"

set -euo pipefail

# --- 1. Repository Root Resolution -------------------------------------------
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
    exit 0
fi

# Ensure working directory is the repository root
cd "$ROOT"

# Bypass if requested
if [[ "${SKIP_HOOKS:-0}" == "1" ]] || [[ "${PRE_COMMIT_SKIP:-0}" == "1" ]]; then
    echo "pre-commit: all hooks skipped via environment variable."
    exit 0
fi

# --- 2. Module Implementations -----------------------------------------------

# Module 1: Version validation (project convention via _check_version)
module_version() {
    local check_script="$ROOT/_check_version"
    if [[ ! -f "$check_script" ]]; then
        return 0
    fi

    echo "==> pre-commit [version]: running $check_script" >&2
    if ! "$check_script" < /dev/null >&2; then
        echo "" >&2
        echo "ERROR: Version validation failed. Commit aborted." >&2
        echo "Run ./_check_version to see details." >&2
        return 1
    fi
    return 0
}

# Module 2: Skill index sync (AGENTS.md vs .agents/skills/ via _skill_sync)
module_skill_sync() {
    local sync_script="$ROOT/_skill_sync"
    if [[ ! -f "$sync_script" ]]; then
        return 0
    fi

    echo "==> pre-commit [skill_sync]: running '$sync_script --check'..." >&2
    if ! "$sync_script" --check < /dev/null >&2; then
        echo "" >&2
        echo "ERROR: AGENTS.md skill index is out of sync. Commit aborted." >&2
        echo "Run ./_skill_sync to regenerate it." >&2
        return 1
    fi
    return 0
}

# Module 3: Lint the whole project with ruff
module_ruff() {
    if ! python3 -m ruff --version >/dev/null 2>&1; then
        echo "pre-commit [ruff]: ruff not found - SKIPPED" >&2
        return 0
    fi

    echo "==> pre-commit [ruff]: running 'python3 -m ruff check .'..." >&2
    if ! python3 -m ruff check .; then
        echo "" >&2
        echo "ERROR: 'ruff check' failed." >&2
        echo "Fix issues or bypass with 'git commit --no-verify' or 'SKIP_RUFF=1'." >&2
        return 1
    fi
    return 0
}

# Module 4: Type-check the project with mypy
module_mypy() {
    if ! python3 -m mypy --version >/dev/null 2>&1; then
        echo "pre-commit [mypy]: mypy not found - SKIPPED" >&2
        return 0
    fi

    echo "==> pre-commit [mypy]: running 'python3 -m mypy'..." >&2
    if ! python3 -m mypy; then
        echo "" >&2
        echo "ERROR: 'mypy' failed." >&2
        echo "Fix type errors or bypass with 'git commit --no-verify' or 'SKIP_MYPY=1'." >&2
        return 1
    fi
    return 0
}

# Module 5: Test suite (uses _tests --quick when present, falls back to pytest)
module_tests() {
    local test_script="$ROOT/_tests"
    if [[ -x "$test_script" ]]; then
        echo "==> pre-commit [tests]: running test suite ($test_script --quick)..." >&2
        if ! "$test_script" --quick < /dev/null; then
            echo "" >&2
            echo "ERROR: Test suite failed. Commit aborted." >&2
            echo "Run ./_tests to see details." >&2
            return 1
        fi
    else
        echo "==> pre-commit [tests]: running 'python3 -m pytest tests/folder_remove_empty -q'..." >&2
        if ! python3 -m pytest tests/folder_remove_empty -q < /dev/null; then
            echo "" >&2
            echo "ERROR: Test suite failed. Commit aborted." >&2
            echo "Run 'python3 -m pytest tests/folder_remove_empty' for details." >&2
            return 1
        fi
    fi
    return 0
}

# window_opens reports whether a tkinter window can be opened right now.
window_opens() {
    python3 - <<'PYINNER' >/dev/null 2>&1
import sys
import tkinter

try:
    tkinter.Tk().destroy()
except Exception:
    sys.exit(1)
PYINNER
}

# gui_smoke_failed prints the window smoke failure and returns 1.
gui_smoke_failed() {
    echo "" >&2
    echo "ERROR: the window smoke failed: it must open and paint no accent fill." >&2
    echo "Run 'python3 -m pytest tests/folder_remove_empty/test_gui.py::AccentTest'." >&2
    echo "Bypass with SKIP_GUI=1 or 'git commit --no-verify'." >&2
    return 1
}

# Module 6: Window smoke (the window opens and carries the accent rule)
#
# The window is opened on a private Xvfb display, never on the screen the user is
# working on. `make check-gui` owns that invocation (xvfb-run, the private marker
# and the window modules); this module only decides between the two modes, so a
# commit and the manual target check exactly the same thing.
# FOLDER_REMOVE_EMPTY_GUI_DISPLAY=session asks for the session screen instead.
module_gui() {
    local -a window_modules=(
        "tests/folder_remove_empty/test_gui.py"
        "tests/folder_remove_empty/test_gui_reference.py"
        "tests/folder_remove_empty/test_private_display.py"
    )

    if [[ ! -d "$ROOT/tests/folder_remove_empty" ]]; then
        echo "pre-commit [gui]: tests/folder_remove_empty missing - SKIPPED" >&2
        return 0
    fi

    if ! command -v xvfb-run >/dev/null 2>&1 && ! window_opens; then
        echo "pre-commit [gui]: no display and no xvfb-run - SKIPPED" >&2
        return 0
    fi

    if [[ "${FOLDER_REMOVE_EMPTY_GUI_DISPLAY:-}" == "session" ]]; then
        echo "==> pre-commit [gui]: opening the window on the session display (asked for)..." >&2
        if ! python3 -m pytest -q "${window_modules[@]}"; then
            gui_smoke_failed
            return 1
        fi
        return 0
    fi

    echo "==> pre-commit [gui]: opening the window on a private display (make check-gui)..." >&2
    if ! make -C "$ROOT" check-gui; then
        gui_smoke_failed
        return 1
    fi
    return 0
}

# Module 7: Generated documentation drift (man page, tldr page)
# Compares '--print-man'/'--print-tldr' with the committed pages. Reads only;
# never writes into the tree. Skips when a page or the generator is unusable so
# it can never mask a real failure reported by another module.
module_docs() {
    local man_page="$ROOT/man/folder_remove_empty.1"
    local tldr_page="$ROOT/tldr/folder_remove_empty.page.md"

    if [[ ! -f "$man_page" || ! -f "$tldr_page" ]]; then
        echo "pre-commit [docs]: man/folder_remove_empty.1 or tldr/folder_remove_empty.page.md missing - SKIPPED" >&2
        return 0
    fi

    if ! python3 -m folder_remove_empty --print-man >/dev/null 2>&1; then
        echo "pre-commit [docs]: the generator ('python3 -m folder_remove_empty --print-man') failed - SKIPPED" >&2
        return 0
    fi

    echo "==> pre-commit [docs]: comparing the generated pages with the committed files..." >&2

    local tmp status=0
    if ! tmp="$(mktemp -d)"; then
        echo "pre-commit [docs]: cannot create a temporary directory - SKIPPED" >&2
        return 0
    fi
    local generated_man="$tmp/folder_remove_empty.1"
    local generated_tldr="$tmp/folder_remove_empty.page.md"

    local generator_failed=0
    if ! python3 -m folder_remove_empty --print-man >"$generated_man" 2>/dev/null; then
        generator_failed=1
    fi
    if ! python3 -m folder_remove_empty --print-tldr >"$generated_tldr" 2>/dev/null; then
        generator_failed=1
    fi

    if [[ "$generator_failed" == "1" ]]; then
        echo "pre-commit [docs]: the generator failed while producing a page - SKIPPED" >&2
        rm -rf "$tmp"
        return 0
    fi

    if ! diff -u "$man_page" "$generated_man" >"$tmp/man.diff" 2>&1; then
        echo "" >&2
        echo "ERROR: man/folder_remove_empty.1 drifted from 'python3 -m folder_remove_empty --print-man'." >&2
        head -20 "$tmp/man.diff" >&2
        status=1
    fi

    if ! diff -u "$tldr_page" "$generated_tldr" >"$tmp/tldr.diff" 2>&1; then
        echo "" >&2
        echo "ERROR: tldr/folder_remove_empty.page.md drifted from 'python3 -m folder_remove_empty --print-tldr'." >&2
        head -20 "$tmp/tldr.diff" >&2
        status=1
    fi

    rm -rf "$tmp"

    if [[ "$status" != "0" ]]; then
        echo "" >&2
        echo "ERROR: Generated documentation is out of date. Commit aborted." >&2
        echo "Run 'make man' and 'make tldr' to regenerate the pages." >&2
        return 1
    fi
    return 0
}

# Module 8: Build / packaging validation (_build script)
module_build() {
    local build_script="$ROOT/_build"
    if [[ ! -f "$build_script" ]]; then
        return 0
    fi

    # _build produces the distribution artifacts (multi-minute task).
    # It runs when PRE_COMMIT_BUILD=1 is set, RUN_BUILD=1 is set, or when explicitly targeted.
    if [[ "${TARGET_MODULE:-}" != "build" ]] && [[ "${PRE_COMMIT_BUILD:-0}" != "1" ]] && [[ "${RUN_BUILD:-0}" != "1" ]]; then
        return 0
    fi

    echo "==> pre-commit [build]: running $build_script" >&2
    if ! "$build_script" < /dev/null >&2; then
        echo "" >&2
        echo "ERROR: _build failed. Commit aborted." >&2
        echo "Run ./_build to see details." >&2
        return 1
    fi
    return 0
}

# Module 9: Dev tool pins (requirements-dev.txt vs the installed tools).
# Warn only: a commit that runs locally is still useful, the reminder is that
# CI installs the pins and therefore checks a different environment.
module_pins() {
    local check_script="$ROOT/_check_pins"
    if [[ ! -f "$check_script" ]]; then
        return 0
    fi

    echo "==> pre-commit [pins]: comparing the installed dev tools with requirements-dev.txt" >&2
    if ! "$check_script" < /dev/null >&2; then
        echo "pre-commit [pins]: the installed tools drift from requirements-dev.txt (warning only)" >&2
    fi
    return 0
}

# Module 10: Drop-in directory modules (hooks/pre-commit.d/*.sh)
module_directory_hooks() {
    local hooks_dir="$ROOT/hooks/pre-commit.d"
    if [[ ! -d "$hooks_dir" ]]; then
        return 0
    fi

    local status=0
    for hook in "$hooks_dir"/*.sh; do
        if [[ -x "$hook" ]]; then
            local hook_name
            hook_name="$(basename "$hook")"
            echo "==> pre-commit [d]: running $hook_name" >&2
            if ! "$hook" < /dev/null >&2; then
                echo "ERROR: Drop-in hook $hook_name failed." >&2
                status=1
            fi
        fi
    done
    return "$status"
}

# --- 3. Module Runner & Dispatcher -------------------------------------------

MODULES=("version" "skill_sync" "ruff" "mypy" "tests" "gui" "docs" "pins" "build" "directory_hooks")

is_module_skipped() {
    local mod="$1"
    local env_var="SKIP_${mod^^}"
    env_var="${env_var//-/_}"
    if [[ "${!env_var:-0}" == "1" ]]; then
        return 0
    fi
    return 1
}

run_module() {
    local mod="$1"
    if is_module_skipped "$mod"; then
        echo "pre-commit: skipping module [$mod] (disabled via SKIP_${mod^^}=1)"
        return 0
    fi

    case "$mod" in
        version)         module_version ;;
        skill_sync)      module_skill_sync ;;
        ruff)            module_ruff ;;
        mypy)            module_mypy ;;
        tests)           module_tests ;;
        gui)             module_gui ;;
        docs)            module_docs ;;
        pins)            module_pins ;;
        build)           module_build ;;
        directory_hooks) module_directory_hooks ;;
        *)
            echo "ERROR: Unknown module '$mod'" >&2
            return 1
            ;;
    esac
}

# --- 4. CLI Argument Parsing -------------------------------------------------

TARGET_MODULE=""

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            cat <<EOF
pre-commit v${__VERSION__} - modular git pre-commit hook

Usage:
  hooks/pre-commit [OPTIONS]

Options:
  -h, --help           Show this help message and exit
  --list-modules       List all available check modules
  --run=<module>       Run only the specified module
  --version            Show hook version and exit

Modules:
  version              Validate version stamps via ./_check_version (if present)
  skill_sync           Validate AGENTS.md skill index via ./_skill_sync --check (if present)
  ruff                 Run 'python3 -m ruff check .' on the whole project
  mypy                 Run 'python3 -m mypy' type checking
  tests                Run test suite (./_tests --quick or python3 -m pytest tests/folder_remove_empty -q)
  gui                  Open the window on a private display, check its structure and the accent rule
  docs                 Compare the generated man/tldr pages with the program output (--print-man/--print-tldr)
  build                Run ./_build (runs when PRE_COMMIT_BUILD=1 or --run=build)
  directory_hooks      Run custom scripts in hooks/pre-commit.d/*.sh

Environment Overrides:
  SKIP_HOOKS=1              Skip all pre-commit modules
  SKIP_<MODULE>=1           Skip specific module (e.g. SKIP_TESTS=1, SKIP_GUI=1, SKIP_DOCS=1, SKIP_RUFF=1)
  PRE_COMMIT_BUILD=1        Enable the build verification module
EOF
            exit 0
            ;;
        --version)
            echo "pre-commit v${__VERSION__}"
            exit 0
            ;;
        --list-modules)
            echo "Available pre-commit modules:"
            for mod in "${MODULES[@]}"; do
                echo "  - $mod"
            done
            exit 0
            ;;
        --run=*)
            TARGET_MODULE="${arg#*=}"
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            echo "Run 'hooks/pre-commit --help' for usage." >&2
            exit 1
            ;;
    esac
done

# --- 5. Main Execution Flow --------------------------------------------------

if [[ -n "$TARGET_MODULE" ]]; then
    run_module "$TARGET_MODULE"
    exit $?
fi

# Run all registered modules in order
for mod in "${MODULES[@]}"; do
    if ! run_module "$mod"; then
        exit 1
    fi
done

exit 0
