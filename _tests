#!/bin/bash
# _tests - run the folder_remove_empty test suite, ruff and mypy checks.
#   usage: ./_tests [OPTIONS]
#   options:
#     --quick    run only the test suite (skip ruff and mypy)
#     -h, --help show this help and exit
#     --version  show the _tests version and exit

__VERSION__="2.0.20260927111114Z"

set -u
set -o pipefail

fail=0
QUICK=0

usage() {
    cat <<EOF
_tests v${__VERSION__} - run the folder_remove_empty checks

usage: ./_tests [OPTIONS]

options:
  --quick       run only the test suite (skip ruff and mypy)
  -h, --help    show this help and exit
  --version     show the _tests version and exit

checks (default, in order):
  [1/3] python3 -m pytest tests/folder_remove_empty
  [2/3] python3 -m ruff check .
  [3/3] python3 -m mypy

exit code: 0 when all checks pass, 1 otherwise
EOF
}

for arg in "$@"; do
    case "$arg" in
        -h|--help)  usage; exit 0 ;;
        --version)  echo "[_tests] v${__VERSION__}"; exit 0 ;;
        --quick)    QUICK=1 ;;
        *)
            echo "[_tests] unknown option or argument: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

echo ""
echo "[_tests] v${__VERSION__} - folder_remove_empty checks"
echo ""

echo "[1/3] python3 -m pytest tests/folder_remove_empty"
if ! python3 -m pytest tests/folder_remove_empty 2>&1 | tail -5; then
    echo "[_tests] pytest FAILED" >&2
    fail=1
fi
echo ""

if [ "$QUICK" -eq 1 ]; then
    echo "[_tests] --quick given: skipping ruff + mypy checks"
    exit $fail
fi

echo "[2/3] python3 -m ruff check ."
if command -v ruff >/dev/null 2>&1; then
    if ! python3 -m ruff check .; then
        echo "[_tests] ruff FAILED" >&2
        fail=1
    fi
else
    echo "[_tests] ruff not found - SKIPPED" >&2
fi
echo ""

echo "[3/3] python3 -m mypy"
if command -v mypy >/dev/null 2>&1; then
    if ! python3 -m mypy; then
        echo "[_tests] mypy FAILED" >&2
        fail=1
    fi
else
    echo "[_tests] mypy not found - SKIPPED" >&2
fi
echo ""

if [ "$fail" -eq 0 ]; then
    echo "[_tests] ALL CHECKS PASSED"
else
    echo "[_tests] CHECKS FAILED (see above)" >&2
fi
exit $fail
