#!/usr/bin/env bash
# _skill_sync - keep AGENTS.md in sync with the skills in .agents/skills/.
#   usage: ./_skill_sync [--check]
#   options:
#     --check    verify only: exit 1 when AGENTS.md is missing, has no
#                skill-sync markers, or its generated skill index is stale.
#                Never writes.
#     -h, --help show this help and exit
#     --version  show the _skill_sync version and exit
#
# What it does:
#   Regenerates the "Project skills" index inside AGENTS.md from the
#   frontmatter (name:, description:, load:) of every
#   .agents/skills/<name>/SKILL.md. The index lives between
#   <!-- skill-sync:begin ... --> and <!-- skill-sync:end --> markers; the
#   rest of AGENTS.md is never touched.
#
# Validation (both modes):
#   - every skill directory must contain a SKILL.md
#   - SKILL.md must have frontmatter with name: and description:
#   - skill names must be unique
#
# The pre-commit hook runs `./_skill_sync --check` (hooks/pre-commit.d/).

__VERSION__="1.0.20260906173544Z"

set -u
set -o pipefail

usage() {
    cat <<EOF
_skill_sync v${__VERSION__} - keep AGENTS.md in sync with .agents/skills/

usage: ./_skill_sync [--check]

options:
  --check    verify only (exit 1 when AGENTS.md or a skill is out of spec)
  -h, --help show this help and exit
  --version  show the _skill_sync version and exit
EOF
}

CHECK=0
for arg in "$@"; do
    case "$arg" in
        --check)   CHECK=1 ;;
        -h|--help) usage; exit 0 ;;
        --version) echo "[_skill_sync] v${__VERSION__}"; exit 0 ;;
        *)
            echo "[_skill_sync] unknown option: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SKILLS_DIR="$ROOT/.agents/skills"
AGENTS_MD="$ROOT/AGENTS.md"

if [ ! -d "$SKILLS_DIR" ]; then
    echo "[_skill_sync] ERROR: skills directory not found: $SKILLS_DIR" >&2
    exit 1
fi

export SKILLS_DIR AGENTS_MD
export SYNC_CHECK="$CHECK"
export SYNC_MARK_BEGIN="<!-- skill-sync:begin (generated by ./_skill_sync -- do not edit) -->"
export SYNC_MARK_END="<!-- skill-sync:end -->"

python3 - <<'PY'
import os
import re
import sys
from pathlib import Path

skills_dir = Path(os.environ["SKILLS_DIR"])
agents_md = Path(os.environ["AGENTS_MD"])
check_mode = os.environ.get("SYNC_CHECK") == "1"
begin = os.environ["SYNC_MARK_BEGIN"]
end = os.environ["SYNC_MARK_END"]

DEFAULT_HEADER = """# AGENTS.md

Entry file for AI coding agents working in this repository.

See `.agentrules` for the project rules and the "Agent Skills Sync Rule".
"""


def read_frontmatter(md_path):
    """read the YAML frontmatter lines of a SKILL.md (None when absent)"""
    text = md_path.read_text(encoding="utf-8")
    lines = text.splitlines()
    i = 0
    # tolerate a leading HTML comment (e.g. __version__) before the frontmatter
    while i < len(lines) and lines[i].strip() == "":
        i += 1
    if i < len(lines) and lines[i].lstrip().startswith("<!--"):
        while i < len(lines) and "-->" not in lines[i]:
            i += 1
        i += 1
    while i < len(lines) and lines[i].strip() == "":
        i += 1
    if i >= len(lines) or lines[i].strip() != "---":
        return None
    fm = []
    for ln in lines[i + 1:]:
        if ln.strip() == "---":
            return fm
        fm.append(ln)
    return fm


def get_field(fm, key):
    """read a scalar or block-scalar field from frontmatter lines"""
    pat = re.compile(r"^" + re.escape(key) + r":\s*(.*)$")
    for i, ln in enumerate(fm):
        m = pat.match(ln)
        if not m:
            continue
        rest = m.group(1).strip()
        if rest in ("", ">", ">>", "|", "|-", "|+", ">-", ">+"):
            buf = []
            for ln2 in fm[i + 1:]:
                if ln2.strip() == "":
                    continue
                if not ln2.startswith((" ", "\t")):
                    break
                buf.append(ln2.strip())
            return " ".join(buf).rstrip()
        return rest
    return None


def is_always(fm):
    """return True when the frontmatter contains 'load: always'"""
    return any(ln.strip() == "load: always" for ln in fm)


def collect_skills():
    """collect (name, description, load) per skill directory; list errors"""
    skills = []
    errors = []
    for entry in sorted(skills_dir.iterdir(), key=lambda p: p.name.lower()):
        if not entry.is_dir() or entry.name.startswith("."):
            continue
        md = entry / "SKILL.md"
        if not md.is_file():
            errors.append(entry.name + ": missing SKILL.md")
            continue
        fm = read_frontmatter(md)
        if fm is None:
            errors.append(entry.name + ": SKILL.md has no frontmatter")
            continue
        name = get_field(fm, "name")
        desc = get_field(fm, "description")
        if not name:
            errors.append(entry.name + ": frontmatter has no name:")
            continue
        if not desc:
            errors.append(entry.name + ": frontmatter has no description:")
            continue
        skills.append((name, desc, is_always(fm)))
    names = [s[0] for s in skills]
    for n in sorted(set(n for n in names if names.count(n) > 1)):
        errors.append("duplicate skill name: " + n)
    return skills, errors


def render(skills):
    """render the generated index block (markers inclusive, no trailing NL)"""
    rows = ["| Skill | Description | Load |", "|---|---|---|"]
    for name, desc, always in sorted(skills):
        safe = desc.replace("|", "\\|")
        rows.append("| `" + name + "` | " + safe + " | " + ("always" if always else "on-demand") + " |")
    return begin + "\n\n" + "\n".join(rows) + "\n\n" + end


skills, errors = collect_skills()
if errors:
    for e in errors:
        print("[_skill_sync] ERROR: " + e, file=sys.stderr)
    sys.exit(1)

if check_mode:
    if not agents_md.is_file():
        print("[_skill_sync] ERROR: AGENTS.md not found - run ./_skill_sync", file=sys.stderr)
        sys.exit(1)
    text = agents_md.read_text(encoding="utf-8")
    if begin not in text or end not in text:
        print("[_skill_sync] ERROR: AGENTS.md has no skill-sync markers - run ./_skill_sync", file=sys.stderr)
        sys.exit(1)
    i = text.index(begin)
    j = text.index(end) + len(end)
    if text[i:j] != render(skills):
        print("[_skill_sync] ERROR: AGENTS.md skill index is stale - run ./_skill_sync", file=sys.stderr)
        sys.exit(1)
    print("[_skill_sync] OK: AGENTS.md skill index in sync (" + str(len(skills)) + " skills)")
    sys.exit(0)

block = render(skills)
if agents_md.is_file():
    text = agents_md.read_text(encoding="utf-8")
    if begin in text and end in text:
        i = text.index(begin)
        j = text.index(end) + len(end)
        new_text = text[:i] + block + text[j:]
    else:
        new_text = text.rstrip("\n") + "\n\n" + block + "\n"
else:
    new_text = DEFAULT_HEADER + "\n" + block + "\n"
agents_md.write_text(new_text, encoding="utf-8", newline="\n")
print("[_skill_sync] wrote skill index for " + str(len(skills)) + " skills into AGENTS.md")
PY
exit $?
