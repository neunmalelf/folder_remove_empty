#!/bin/bash
# _install - install or update folder_remove_empty directly into Python (no .venv needed).
# Installs folder_remove_empty in editable mode (`pip install -e '.[dev]'`).
# The `folder_remove_empty` console script is installed automatically.
# On later runs the repo is synced from origin first via a guarded
# `git pull --ff-only`.
#   usage: ./_install [options]
#   options:
#     -h, --help    show this help and exit
#     --version     show the _install version and exit
#   afterwards: folder_remove_empty --help · ./_tests

__VERSION__="3.0.20260927111114Z"

set -u

cd "$(dirname "$0")"

# --- usage -------------------------------------------------------------------
usage() {
    cat <<EOF
_install v${__VERSION__} - setup and update folder_remove_empty (direct install, no .venv)

usage: ./_install [OPTIONS]

options:
  -h, --help    show this help and exit
  --version     show the _install version and exit

installs:   folder_remove_empty (editable: python3 -m pip install -e ".[dev]") + ruff + mypy
afterwards: run 'folder_remove_empty --help' from anywhere, and './_tests'

exit code: 0 on success, 1 on failure
EOF
}

# --- argument parsing --------------------------------------------------------
case "${1:-}" in
    -h|--help)  usage; exit 0 ;;
    --version)  echo "[_install] v${__VERSION__}"; exit 0 ;;
    "")         : ;;
    *)          echo "[_install] unknown option: ${1}" >&2; usage >&2; exit 1 ;;
esac

echo ""
echo "[_install] v${__VERSION__} - folder_remove_empty setup (direct install)"
echo ""

# --- sync from origin (guarded pull) ----------------------------------------
if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        echo "[_install] WARNING: uncommitted local changes present" >&2
        echo "[_install] pulling with --ff-only (fails if the branches have diverged)" >&2
    fi
    if ! git pull --ff-only 2>/dev/null; then
        echo "[_install] WARNING: git pull skipped or failed - continuing with local sources" >&2
    fi
else
    echo "[_install] WARNING: no git repository found - skipping git pull" >&2
fi

# --- install directly via pip -----------------------------------------------
echo "[_install] installing folder_remove_empty (editable: python3 -m pip install -e \".[dev]\")"
python3 -m pip install -e ".[dev]"

# --- verify -----------------------------------------------------------------
echo "[_install] verifying..."
python3 -c "import remove_empty_folder_version as v; print(v.APP_NAME, v.__VERSION__)" \
    || { echo "[_install] folder_remove_empty verification failed" >&2; exit 1; }

# verify the console script entry point
if command -v folder_remove_empty >/dev/null 2>&1; then
    echo "[_install] folder_remove_empty present: $(command -v folder_remove_empty)"
    folder_remove_empty --version \
        || echo "[_install] NOTICE: folder_remove_empty not currently found in PATH (ensure ~/.local/bin or Python scripts dir is in PATH)"
else
    echo "[_install] NOTICE: folder_remove_empty not currently found in PATH (ensure ~/.local/bin or Python scripts dir is in PATH)"
fi

echo ""
echo "[_install] DONE. You can now use folder_remove_empty globally without activating any venv:"
echo "    folder_remove_empty [options]    # remove empty folders (see --help)"
echo "  or in Python:"
echo "    import remove_empty_folder_version"
echo "  run test suite with:"
echo "    ./_tests"
echo ""
