#!/usr/bin/env bash
# _check_pins - report installed dev tools that drift from requirements-dev.txt.
#   usage: ./_check_pins [options]
#   options:
#     -h, --help     show this help and exit
#     --version      show the _check_pins version and exit
#     --strict       exit 1 on drift (default: warn only, exit 0)
#     --quiet        print nothing when the pins match
#     --file FILE    read the pins from FILE (default: requirements-dev.txt)
#     --update       rewrite FILE with the installed versions (after a run that
#                    was verified with them)
#
# The pins are what CI installs, so a drift between them and the interpreter you
# are working in means a local check did not run in the verified environment.
# The pre-commit hook runs this script as a reminder; it never blocks a commit.

__VERSION__="1.0.20260927210043Z"

set -u
set -o pipefail

if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    cd "$git_root"
fi

PINS_FILE="requirements-dev.txt"
STRICT=0
QUIET=0
UPDATE=0

usage() {
    cat <<EOF
_check_pins v${__VERSION__} - report dev tools that drift from the pins

usage: ./_check_pins [OPTIONS]

options:
  -h, --help     show this help and exit
  --version      show the _check_pins version and exit
  --strict       exit 1 on drift (default: warn only, exit 0)
  --quiet        print nothing when the pins match
  --file FILE    read the pins from FILE (default: requirements-dev.txt)
  --update       rewrite FILE with the installed versions (after a run that was
                 verified with them); the comment header stays

examples:
  ./_check_pins                     warn when the installed tools drift
  ./_check_pins --quiet             silent unless something drifts
  ./_check_pins --strict            fail on drift (CI or a release check)
  ./_check_pins --update            pin what is installed right now
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        --version)
            echo "_check_pins v${__VERSION__}"
            exit 0
            ;;
        --strict)
            STRICT=1
            shift
            ;;
        --quiet)
            QUIET=1
            shift
            ;;
        --update)
            UPDATE=1
            shift
            ;;
        --file)
            if [[ $# -lt 2 ]]; then
                echo "_check_pins: --file needs a path" >&2
                exit 2
            fi
            PINS_FILE="$2"
            shift 2
            ;;
        *)
            echo "_check_pins: unknown option '$1' (try --help)" >&2
            exit 2
            ;;
    esac
done

if ! command -v python3 >/dev/null 2>&1; then
    echo "_check_pins: python3 is missing - SKIPPED" >&2
    exit 0
fi

python3 - "$PINS_FILE" "$STRICT" "$QUIET" "$UPDATE" <<'PY'
"""compare the installed distributions with the pins of a requirements file."""

import importlib.metadata
import pathlib
import sys

pins_path = pathlib.Path(sys.argv[1])
strict = sys.argv[2] == "1"
quiet = sys.argv[3] == "1"
update = sys.argv[4] == "1"

if not pins_path.is_file():
    print(f"_check_pins: {pins_path} is missing - SKIPPED", file=sys.stderr)
    raise SystemExit(0)

pins: dict[str, str] = {}
for line in pins_path.read_text().splitlines():
    line = line.split("#", 1)[0].strip()
    if "==" not in line:
        continue
    name, _, version = line.partition("==")
    pins[name.strip()] = version.strip()

def installed(name: str) -> str | None:
    """report the version of an installed distribution
    usage: installed <NAME>
    returns: the version, or None when the distribution is not installed

    example: installed("pytest")

    """
    try:
        return importlib.metadata.version(name)
    except importlib.metadata.PackageNotFoundError:
        return None


drift: list[tuple[str, str, str]] = []
for name in sorted(pins):
    want = pins[name]
    have = installed(name)
    if have is None:
        drift.append((name, want, "not installed"))
        continue
    if have != want:
        drift.append((name, want, have))

if update:
    lines = pins_path.read_text().splitlines(keepends=True)
    rewritten: list[str] = []
    changes: list[str] = []
    for line in lines:
        stripped = line.split("#", 1)[0].strip()
        name = stripped.partition("==")[0].strip() if "==" in stripped else ""
        have = installed(name) if name else None
        if not name or have is None:
            rewritten.append(line)
            continue
        want = stripped.partition("==")[2].strip()
        if have != want:
            changes.append(f"  {name}: {want} -> {have}")
        rewritten.append(line.replace(f"=={want}", f"=={have}", 1))
    if not changes:
        print(f"_check_pins: {pins_path.name} already matches the installed tools")
        raise SystemExit(0)
    pins_path.write_text("".join(rewritten))
    print(f"WARNING: {pins_path.name} updated to the installed tools:", file=sys.stderr)
    for change in changes:
        print(change, file=sys.stderr)
    print("  re-run the checks with these versions before committing")
    raise SystemExit(0)

if not drift:
    if not quiet:
        print(f"_check_pins: {len(pins)} pinned tool(s) match {pins_path.name}")
    raise SystemExit(0)

print(f"WARNING: the installed dev tools drift from {pins_path.name}:", file=sys.stderr)
for name, want, have in drift:
    print(f"  {name}: pinned {want}, installed {have}", file=sys.stderr)
print(f"  CI installs the pins: python3 -m pip install -r {pins_path}", file=sys.stderr)
raise SystemExit(1 if strict else 0)
PY
