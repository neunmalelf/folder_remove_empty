#!/usr/bin/env bash
# _run - launch folder_remove_empty directly without installing.
#
#   ./_run                      start the window (same as running with no arguments)
#   ./_run --no-gui [PATH]      work on the terminal instead of opening a window
#   ./_run [ARGS...]            pass any other argument straight through to the program
#
# Examples:
#   ./_run --version            print the version banner and exit
#   ./_run --no-gui ~/Downloads remove empty folders below ~/Downloads

__VERSION__="2.0.20260927111114Z"

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

exec python3 -m folder_remove_empty "$@"
