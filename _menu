#!/bin/bash
# _menu - ddpico helper menu (install / test / build / backup / git).
#   usage: ./_menu [OPTIONS]
#   options:
#     -h, --help    show this help and exit
#     --version     show the _menu version and exit

__VERSION__="1.18.20260917180146Z"
_jobname="[_menu]"

# --- colors (defined before usage so the help text can use them) ------------
_COLOR_RESET="$(printf '\033[0m')"
_COLOR_FG_CYAN="$(printf '\033[1;36m')"
_COLOR_FG_GREEN="$(printf '\033[1;32m')"
_COLOR_FG_YELLOW="$(printf '\033[1;33m')"

# --- usage -------------------------------------------------------------------
usage() {
    cat <<EOF
_menu v${__VERSION__} - helper menu for common ddpico maintenance tasks

usage: ./_menu [OPTIONS]

options:
  -h, --help       show this help and exit
  --version        show the _menu version and exit

menu:
  1  install       ./_install
  s  symlinks      ./_symlinks
  2  test          ./_tests
  3  build         ./_build
  4  backup        _bak           (external utility; shown only when installed)
  5  git           ./_git          (shown only when the script exists)
  6  git push      git push
  ${_COLOR_FG_CYAN}r  run ddpico   python3 -m ddpico repl${_COLOR_RESET}
  ${_COLOR_FG_GREEN}f  run ddfart   python3 ddfart_entry.py --help${_COLOR_RESET}
  99|q|end         quit the menu

exit code: 0 when the menu ends normally
EOF
}

# --- argument parsing --------------------------------------------------------
case "${1:-}" in
    -h|--help)      usage; exit 0 ;;
    --version)      echo "${_jobname} v${__VERSION__}"; exit 0 ;;
    "")             : ;;
    *)              echo "${_jobname} unknown option: ${1}" >&2; usage >&2; exit 1 ;;
esac

# --- work relative to this script's directory --------------------------------
cd "$(dirname "$0")" || exit 1

# --- menu loop ----------------------------------------------------------------
while true; do
    echo ""
    echo "ddpico helper menu (${__VERSION__})"
    echo ""
    echo "        1) install"
    echo "        s) symlinks (./_symlinks)"
    echo "        ${_COLOR_FG_CYAN}2) test${_COLOR_RESET}"
    echo "        3) build"
    command -v _bak >/dev/null 2>&1 && echo "        ${_COLOR_FG_CYAN}4) backup${_COLOR_RESET}"
    [ -f "_git" ] && echo "        5) git"
    echo "        ${_COLOR_FG_CYAN}6) git push${_COLOR_RESET}"
    echo "        ${_COLOR_FG_CYAN}r) run ddpico (python3 -m ddpico repl)${_COLOR_RESET}"
    echo "        ${_COLOR_FG_GREEN}f) run ddfart (python3 ddfart_entry.py)${_COLOR_RESET}"
    echo "        ${_COLOR_FG_YELLOW}q) quit_menu${_COLOR_RESET}"
    echo ""
    printf "choose: "
    read -r choice || { echo "${_jobname} bye"; break; }
    case "$choice" in
        1)      ./_install ;;
        s|S)    ./_symlinks ;;
        2)      ./_tests ;;
        3)      ./_build ;;
        4)      if command -v _bak >/dev/null 2>&1; then _bak; else echo "${_jobname} _bak utility not found"; fi ;;
        5)      if [ -f "_git" ]; then ./_git; else echo "${_jobname} no _git script found"; fi ;;
        6)      git push ;;
        r|R)    python3 -m ddpico repl ;;
        f|F)    python3 ddfart_entry.py --help ;;
        99|q|Q|end|quit|exit) echo "${_jobname} bye"; break ;;
        *)      echo "${_jobname} unknown choice: ${choice}" ;;
    esac
done

if [ -n "${BASH_SOURCE:-}" ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
    return 0
fi
exit 0
